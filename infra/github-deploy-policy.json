{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublishWebsiteAssets",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::agent-pair-web-184644493945-us-east-1/*"
    },
    {
      "Sid": "ListWebsiteBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::agent-pair-web-184644493945-us-east-1"
    },
    {
      "Sid": "InvalidateWebsiteDistribution",
      "Effect": "Allow",
      "Action": "cloudfront:CreateInvalidation",
      "Resource": "arn:aws:cloudfront::184644493945:distribution/E2ZUVW9MGY7DBS"
    },
    {
      "Sid": "DeployContactStack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStacks",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:GetTemplate"
      ],
      "Resource": "arn:aws:cloudformation:us-east-1:184644493945:stack/agent-pair-contact/*"
    },
    {
      "Sid": "ReadContactTemplateMetadata",
      "Effect": "Allow",
      "Action": "cloudformation:GetTemplateSummary",
      "Resource": "*"
    },
    {
      "Sid": "ManageContactLambda",
      "Effect": "Allow",
      "Action": "lambda:*",
      "Resource": "arn:aws:lambda:us-east-1:184644493945:function:agent-pair-contact"
    },
    {
      "Sid": "ManageContactRateLimitTable",
      "Effect": "Allow",
      "Action": "dynamodb:*",
      "Resource": "arn:aws:dynamodb:us-east-1:184644493945:table/agent-pair-contact-rate-limit"
    },
    {
      "Sid": "ManageContactApi",
      "Effect": "Allow",
      "Action": ["apigateway:DELETE", "apigateway:GET", "apigateway:PATCH", "apigateway:POST", "apigateway:PUT"],
      "Resource": "arn:aws:apigateway:us-east-1::/apis*"
    },
    {
      "Sid": "ManageContactFunctionRole",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:PutRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": "arn:aws:iam::184644493945:role/agent-pair-contact-function"
    },
    {
      "Sid": "PassContactFunctionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::184644493945:role/agent-pair-contact-function",
      "Condition": {"StringEquals": {"iam:PassedToService": "lambda.amazonaws.com"}}
    }
  ]
}
